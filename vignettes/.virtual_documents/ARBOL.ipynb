options(repr.plot.width=11,repr.plot.height=10)
ggraph(se2@misc$cluster_ggraph, layout='tree', circular=T) + 
    geom_edge_diagonal2(aes(color=node.Lineage_majority), linewidth=1.5) + theme_void() + 
    scale_edge_colour_brewer(palette='Set2') +
